rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      // Real-time Wallets Subcollection
      match /wallets/{walletId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(walletId);
        allow update: if isOwner(userId);
        allow delete: if false;
      }

      // Real-time Transactions Subcollection
      match /transactions/{txId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(txId);
        allow update: if false; // Transaction ledger records are append-only & immutable
        allow delete: if false;
      }

      // KYC Documents Subcollection
      match /kyc_documents/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(docId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Real-time Notifications Subcollection
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(notificationId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    // Connection test doc
    match /test/{docId} {
      allow read: if true;
    }

    // Real-Time SystemErrors Telemetry & Stack Trace Collection
    match /SystemErrors/{errorId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isSignedIn();
    }

    // Real-Time Security Events (HMAC verifications, invalid signatures, replay attacks)
    match /security_events/{eventId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Edge IP Rate Limiting & Threat Mitigation Collection
    match /ip_rate_limits/{ipId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Webhook Interception & Audit History Logs
    match /webhook_logs/{webhookId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
  }
}

