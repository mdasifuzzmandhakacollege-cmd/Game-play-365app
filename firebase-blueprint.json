{
  "entities": {
    "User": {
      "title": "User",
      "description": "GamePlay365 registered player profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 255 },
        "phone": { "type": "string", "maxLength": 30 },
        "currency": { "type": "string", "enum": ["BDT", "USD"] },
        "vipTier": { "type": "string", "maxLength": 50 },
        "vipPoints": { "type": "number" },
        "affiliateCode": { "type": "string", "maxLength": 50 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "username", "currency", "vipTier"]
    },
    "Wallet": {
      "title": "Wallet",
      "description": "Real-time user financial ledger balance",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "currency": { "type": "string", "enum": ["BDT", "USD"] },
        "realBalance": { "type": "number" },
        "bonusBalance": { "type": "number" },
        "lockedBalance": { "type": "number" },
        "version": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "currency", "realBalance"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Real-time gaming & cashier financial ledger transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "transactionId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "walletId": { "type": "string", "maxLength": 128 },
        "providerId": { "type": "string", "maxLength": 100 },
        "gameId": { "type": "string", "maxLength": 100 },
        "roundId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["BET", "WIN", "REFUND", "DEPOSIT", "WITHDRAW"] },
        "amount": { "type": "number" },
        "currency": { "type": "string", "enum": ["BDT", "USD"] },
        "beforeBalance": { "type": "number" },
        "afterBalance": { "type": "number" },
        "status": { "type": "string", "enum": ["COMMITTED", "FAILED", "ROLLEDBACK"] },
        "referenceTransactionId": { "type": "string", "maxLength": 128 },
        "auditHash": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "transactionId", "userId", "type", "amount", "currency", "status"]
    },
    "KycDocument": {
      "title": "KycDocument",
      "description": "Google Drive KYC verification record and status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 255 },
        "mimeType": { "type": "string", "maxLength": 128 },
        "url": { "type": "string", "maxLength": 512 },
        "docType": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["PENDING", "VERIFIED", "REJECTED"] },
        "rejectionReason": { "type": "string", "maxLength": 255 },
        "sizeBytes": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Real-time user notification event for withdrawals, bonus unlocks and system alerts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 255 },
        "message": { "type": "string", "maxLength": 1000 },
        "type": { "type": "string", "enum": ["WITHDRAWAL_APPROVED", "BONUS_UNLOCKED", "DEPOSIT_CONFIRMED", "VIP_UPGRADE", "AFFILIATE_COMMISSION", "SYSTEM_ALERT"] },
        "amount": { "type": "number" },
        "currency": { "type": "string", "enum": ["BDT", "USD"] },
        "isRead": { "type": "boolean" },
        "actionUrl": { "type": "string", "maxLength": 255 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "message", "type", "isRead"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Player profile records"
    },
    "/users/{userId}/wallets/{walletId}": {
      "schema": { "$ref": "#/entities/Wallet" },
      "description": "Player wallet balance documents"
    },
    "/users/{userId}/transactions/{txId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Financial ledger transaction audit trails"
    },
    "/users/{userId}/kyc_documents/{docId}": {
      "schema": { "$ref": "#/entities/KycDocument" },
      "description": "Google Drive KYC document attachments per user"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Real-time user notifications subcollection"
    }
  }
}
